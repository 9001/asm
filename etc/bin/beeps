#!/bin/ash
set -e

# volume is 75% unless 1st line in /sm/sound.txt;
# 1st soundcard unless 2nd line in /sm/sound.txt;
# mute by creating an empty file at /sm/quiet

[ -e $AF/sm/quiet ] || [ -e /dev/shm/nobeep ] && {
    rmmod pcspkr 2>/dev/null || true
    exit 0
}

case "$1" in
    ack) exec beeps 20 660 0 880;;  # 1047 0 784
    ok)  exec beeps 60 523 784 1047;;
    sad) exec beeps 80 349 0 349;;
esac

[ $# -gt 1 ] || {
    echo need arg 1: note duration in ms
    echo need arg 2: frequency of note 1
    echo optional arg 3+: note frequencies
    exit 1
}

d=$1
shift

# native beep
nbeep() {
    for f; do
        [ $f = 0 ] && sleep $(awk "BEGIN {print $d/1000}" </dev/null) && continue
        beep -f $f -l $d
    done
}

# alsa-beep
abeep() {
    command -v aplay >/dev/null &&
        aplay=1 && prog=aplay && parg= || {
            prog=tinyplay; parg="-i wav"
    }
    killall -q $prog || true
    avol=75
    ad=
    f=$AF/sm/sound.txt
    [ -s $f ] && {
        avol=$(awk <$f -F% -vv=$avol 'NR==1&&/^[0-9]/{v=$1}END{print v}')  # line 1 = volume
        l1="$(awk <$f NR==2)"  # line 2 = card name
        l2="$(awk <$f NR==3)"  # line 3 = nth port on card
        [ "$l1" ] && l1="$(awk </proc/asound/cards -vp="$l1" '/^[ 0-9][0-9] \[/{n=$1} $0~p{print n;exit}')"
        [ "$l1" ] && {
            ad="-D $l1"
            [ "$l2" ] && ad="$ad -d $l2"
            if [ "$aplay" ]; then
                parg="$parg -D hw:$l1"
                [ "$l2" ] && parg="$parg,$l2"
            else
                parg="$ad $parg"
            fi
        }
    }
    [ "$ad" ] || {
        for n in 0 1 2 3 4 ; do
            tinypcminfo -D $n 2>/dev/null | grep -EA1 '^PCM out:' | grep -q 0x || continue
            ad="-D $n"
            if [ "$aplay" ]; then
                parg="$parg -D hw:$n"
            else
                parg="$ad $parg"
            fi
            break
        done
    }
    [ -e /dev/shm/volset ] || {
        touch /dev/shm/volset
        for m in 'Master Playback' 'PCM Playback' 'Speaker Playback'; do
            tinymix $ad set "$m Volume" $avol% 2>/dev/null || true
            tinymix $ad set "$m Volume" $avol% $avol% 2>/dev/null || true
            tinymix $ad set "$m Switch" 1 2>/dev/null || true
            tinymix $ad set "$m Switch" 1 1 2>/dev/null || true
        done
    }

    # b=samplebits c=chans r=samplerate
    b=; c=; r=;
    eval "$(tinypcminfo $ad 2>/dev/shm/pcmerr | awk '
        /^PCM /{o=0}
        /^PCM out:/{o=1}
        !o{next}
        {k=""}
        /Format Name:/{k="b"}
        /Channels:/{k="c"}
        /Rate:/{k="r"}
        /=/{sub(/[^=]+=/,"");sub(/[^0-9].*/,"")}
        {sub(/,.*/,"");sub(/_3/,"");gsub(/[^0-9]/,"")}
        k{printf "%s=%s\n",k,$0}
    ')"
    [ "$r" ] || return

    local fl=/dev/shm/beeped

    {
        hgen
        [ -e $fl ] || {
            touch $fl
            fgen 386 0  # metal
        }
        for f; do
            fgen $d $f
        done
        fgen 333 0  # qemu
    } |
    $prog $parg - >/dev/null 2>/dev/null
}

hgen() {
    awk -vb=$b -vc=$c -vr=$r '
function h(n){printf"%c%c",n%256,(n/256)%256}
function i(n){h(n) h(n/65536)}
BEGIN{
    s=c*b/8;
    printf"RIFFZZZ0WAVEfmt ";
    i(16) h(1) h(c) i(r) i(r*s) h(r) h(b)
    printf"data6ZZ0"}'
}

fgen() {
    awk -vb=$b -vc=$c -vr=$r -vd=$1 -vf=$2 'BEGIN{
        if(!f) {
            w=sprint "\x01";
            e=(r*c*(b/8)*d/1000); i=1;
            while(i<e) {i*=2;w=w w}
            print substr(w,1,e);
            exit;
        }
        w1=sprint "\x7f";
        w2=sprint "\x81";
        e=(r*c*b)/(16*f); i=1;
        while(i<e) {i*=2;w1=w1 w1;w2=w2 w2}
        w=substr(w1,1,e) substr(w2,1,e);
        t=(((r*d)/1000)*c*(b/8))/(e*2);
        for(n=0;n<t;n++) print(w);
    }'
}

[ -e /proc/asound/cards ] && [ -e $AF/sm/sound.txt ] && {
    command -v tinyplay >/dev/null && {
        abeep "$@"
        exit
    }
    echo $AF/apks/*/tinyalsa-* | grep -q apk$ && {
        p="tinyalsa"
        echo $AF/apks/*/alsa-utils-* | grep -q apk$ && p="$p alsa-utils"
        apka -q --progress=no $p && rm -rf /usr/share/alsa/ucm2 && abeep "$@"
        exit
    }
}

nbeep "$@"
