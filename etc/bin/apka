#!/bin/ash
# undo add if error

printf ' %s ' "$@" | grep -qF ' ffmpeg ' && {
    av=; for a in "$@"; do case "$a" in
        ffmpeg) av="$av $AF/apks/*/ffmpeg-[1-9l]*.apk";;
        *) av="$av '$a'";;
    esac; done
    eval "set -- $av"
}

aa="--force-non-repository --wait 10"
grep -q tty $AF/sm/log.cfg 2>/dev/null &&
    aa="$aa --no-progress"

/sbin/apk $aa add !pyc "$@" && exit 0 || rv=$?

# packages from argv
pkgs="$(
    printf '%s\n' "$@" |
    grep -vE '^[!-]' |
    tr '\n' ' '
)"

# determine which ones failed
rm="$(
    apk policy $pkgs |
    awk 'function c(){ if(p&&!k) printf "%s ",p} !/^ /{c();p=$1;k=0} /installed$/{k=1} END{c()}'
)"

[ "$rm" ] || {
    case "$1" in
        cmd:*) rm=$1;;
        *) exit $rv;;  # 404 in apkindex
    esac
}

echo "skipping unavailable pkgs: $rm" >&2
apk $aa del -q $rm
printf '%s\n' "$rm" > /dev/shm/apka.rm
exit $rv
